# Rafiq configuration. Copy to .env and fill in what you need.

# "Today" for the demo. The synthetic pack is built for 2026-10-14.
RAFIQ_AS_OF=2026-10-14

# AI writer: offline | anthropic | openai
#   offline   - deterministic replies, no external calls (default; demo-safe)
#   anthropic - Claude via the Anthropic API
#   openai    - any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, an approved gateway)
LLM_PROVIDER=offline

ANTHROPIC_API_KEY=<your-anthropic-key>
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=<your-key>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# For Azure OpenAI: OPENAI_API_STYLE=azure and
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
OPENAI_API_STYLE=openai

# Aggregated insights hide groups smaller than this (POL-PRV-001 §5.3)
RAFIQ_MIN_GROUP_SIZE=10
